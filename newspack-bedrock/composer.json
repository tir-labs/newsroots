{
  "name": "postdated/newspack-bedrock",
  "type": "project",
  "license": "GPL-2.0-or-later",
  "description": "Newspack Bedrock v1.1.0 \u2014 local-first newsroom on Roots Bedrock + Acorn",
  "homepage": "https://github.com/Postdated/NewsRock",
  "keywords": [
    "bedrock",
    "composer",
    "roots",
    "wordpress-composer",
    "wordpress",
    "newspack",
    "newsroom"
  ],
  "repositories": [
    {
      "name": "wp-packages",
      "type": "composer",
      "url": "https://repo.wp-packages.org"
    },
    {
      "type": "path",
      "url": "packages/*",
      "options": {
        "symlink": true
      }
    }
  ],
  "require": {
    "php": ">=8.3",
    "automattic/newspack-ads": "3.15.1",
    "automattic/newspack-blocks": "4.31.2",
    "automattic/newspack-cache-cozy": "0.6.2",
    "automattic/newspack-elections": "2.0.4",
    "automattic/newspack-multibranded-site": "2.2.0",
    "automattic/newspack-newsletters": "3.41.1",
    "automattic/newspack-plugin": "6.52.0-alpha.1",
    "automattic/newspack-popups": "3.18.1",
    "automattic/newspack-post-image-downloader": "1.3.1",
    "automattic/newspack-revisions-enhanced": "0.2.0",
    "automattic/newspack-rolling-coverage": "0.1.0",
    "automattic/newspack-sponsors": "2.2.3",
    "automattic/newspack-story-budget": "1.3.2-alpha.1",
    "composer/installers": "^2.0",
    "featuredimagefromurl/fifu-premium": "7.1.9",
    "flux-plugins/flux-media-optimizer": "4.3.1",
    "oscarotero/env": "^2.0",
    "postdated/newpack-discord-bot-api": "1.1.0",
    "postdated/newspack-local-esps": "1.1.0",
    "postdated/newsroom-image-downloader": "1.1.0",
    "postdated/newsroom-speed-cache": "1.1.0",
    "roots/acorn": "^5.0",
    "roots/bedrock-autoloader": "^1.0",
    "roots/bedrock-disallow-indexing": "^2.0",
    "roots/wordpress": "7.1.1",
    "roots/wp-config": "^1.0",
    "vlucas/phpdotenv": "^5.0",
    "wp-plugin/co-authors-plus": "^4.1",
    "wp-theme/twentytwentyfive": "^1.0",
    "postdated/newspack-bedrock-pack": "1.1.0",
    "bwps/prevent-direct-access": "2.8.9.1",
    "elightup/slim-seo": "4.10.1",
    "onesignal/onesignal-free-web-push-notifications": "3.9.3",
    "wp-plugin/ai": "*",
    "livewire/livewire": "^3.0"
  },
  "require-dev": {
    "laravel/pint": "^1.0",
    "pestphp/pest": "^4.0",
    "roave/security-advisories": "dev-latest"
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "allow-plugins": {
      "composer/installers": true,
      "roots/wordpress-core-installer": true,
      "pestphp/pest-plugin": true
    },
    "sort-packages": true
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "extra": {
    "installer-paths": {
      "web/app/mu-plugins/{$name}/": [
        "type:wordpress-muplugin"
      ],
      "web/app/plugins/{$name}/": [
        "type:wordpress-plugin"
      ],
      "web/app/themes/{$name}/": [
        "type:wordpress-theme"
      ]
    },
    "wordpress-install-dir": "web/wp",
    "newspack-bedrock-version": "1.1.0"
  },
  "scripts": {
    "lint": "pint --test",
    "lint:fix": "pint",
    "test": "pest",
    "post-autoload-dump": [
      "Roots\\Acorn\\ComposerScripts::postAutoloadDump"
    ]
  },
  "support": {
    "issues": "https://github.com/Postdated/NewsRock/issues",
    "forum": "https://discourse.roots.io/category/bedrock"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  }
}
