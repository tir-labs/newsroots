# Discord Polling Bot Configuration
# Copy this to .env and fill in your values

# Discord webhook URL (create one in Discord channel settings > Integrations > Webhooks)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# WordPress site URL (no trailing slash)
WP_SITE_URL=https://yoursite.com

# API key (set in WordPress admin > Settings > Discord Bot API)
WP_API_KEY=your-api-key-here

# Polling interval in milliseconds (default: 30000 = 30 seconds)
POLL_INTERVAL_MS=30000

# State file location (tracks what's already been posted)
STATE_FILE=./bot-state.json

