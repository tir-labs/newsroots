{
  "name": "postdated/newswoo",
  "type": "wordpress-plugin",
  "description": "WooCommerce rebuilt for newsrooms — lean subscriptions, memberships, and paywall access.",
  "keywords": ["wordpress", "woocommerce", "newspack", "subscriptions", "newsroom"],
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.3",
    "roots/acorn": "^5.0"
  },
  "autoload": {
    "psr-4": {
      "NewsWoo\\": "app/"
    },
    "files": [
      "app/helpers.php"
    ]
  },
  "extra": {
    "acorn": {
      "providers": [
        "NewsWoo\\Providers\\NewsWooServiceProvider"
      ]
    },
    "installer-paths": {
      "web/app/plugins/{$name}/": ["type:wordpress-plugin"],
      "web/app/mu-plugins/{$name}/": ["type:wordpress-muplugin"]
    }
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "allow-plugins": {
      "composer/installers": true,
      "roots/wordpress-core-installer": true
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}

